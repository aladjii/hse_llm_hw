{
  "max_prompt_tokens": 3072,
  "validation_examples": 128,
  "reward": "shaped",
  "lora": {
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.0,
    "bias": "none",
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "in_proj_qkv",
      "in_proj_z",
      "in_proj_a",
      "in_proj_b",
      "out_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  },
  "training": {
    "seed": 42,
    "data_seed": 42,
    "max_steps": 300,
    "learning_rate": 5e-06,
    "per_device_train_batch_size": 2,
    "gradient_accumulation_steps": 8,
    "per_device_eval_batch_size": 4,
    "num_generations": 4,
    "num_generations_eval": 4,
    "max_completion_length": 1024,
    "temperature": 0.8,
    "top_p": 0.95,
    "beta": 0.02,
    "loss_type": "grpo",
    "scale_rewards": "group",
    "importance_sampling_level": "token",
    "epsilon": 0.2,
    "num_iterations": 1,
    "lr_scheduler_type": "cosine",
    "max_grad_norm": 1.0,
    "bf16": true,
    "gradient_checkpointing": true,
    "gradient_checkpointing_kwargs": {
      "use_reentrant": false
    },
    "use_vllm": false,
    "mask_truncated_completions": true,
    "remove_unused_columns": false,
    "logging_steps": 1,
    "save_steps": 50,
    "eval_steps": 50,
    "eval_strategy": "steps",
    "save_strategy": "steps",
    "save_total_limit": 2,
    "load_best_model_at_end": true,
    "metric_for_best_model": "reward",
    "greater_is_better": true,
    "report_to": [],
    "push_to_hub": false,
    "warmup_steps": 30
  },
  "name": "grpo_shaped",
  "hypothesis": "частичная награда за имена и полные вызовы уменьшает разреженность сигнала"
}
